APP_NAME=YJDownloadVideo
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./data/yjdownload.db
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost:8000
STORAGE_DIR=./storage
# مدة بقاء الملفات على السيرفر بالثواني (86400 = 24 ساعة ثم حذف تلقائي)
FILE_TTL_SECONDS=86400
MAX_FILE_SIZE_BYTES=2147483648
# 0 = بدون حد لمدة الفيديو
MAX_DURATION_SECONDS=0
RATE_LIMIT_PER_MINUTE=10
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_API_ID=put-your-api-id-here
TELEGRAM_API_HASH=put-your-api-hash-here
TELEGRAM_SEND_LIMIT_BYTES=2097152000
# Local Bot API server (يرفع حد الإرسال إلى 2GB): http://tba:8081 في Docker
# TELEGRAM_BOT_API_BASE=
WORKER_CONCURRENCY=2
ALLOWED_HOSTS=localhost,127.0.0.1

# Never commit your real .env file.
# Only use this service for content you are authorized to download.
# DRM bypass and site protection circumvention are intentionally unsupported.

COMPOSE_PROJECT_NAME=yjdownloadvideo
POSTGRES_DB=unused
POSTGRES_USER=unused
POSTGRES_PASSWORD=unused
BOT_USERNAME=
CLEANUP_INTERVAL_SECONDS=300
# مهلة حماية للعملية نفسها وليست حدًا لمدة الفيديو (21600 = 6 ساعات)
DOWNLOAD_TIMEOUT_SECONDS=21600
MAX_ACTIVE_JOBS_PER_IP=2
MAX_ACTIVE_JOBS_PER_TELEGRAM_USER=2
USER_AGENT=YJDownloadVideo/1.0 (+https://localhost)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000

# Optional: set to true only behind HTTPS in production
SECURE_COOKIES=false

# yt-dlp/FFmpeg binaries can be overridden if not on PATH
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# Universal Extractor: headless-browser capture layer (catches JS-only players)
# BROWSER_BIN=chromium
# ENABLE_BROWSER_CAPTURE=true
# REQUEST_TIMEOUT_SECONDS=30
# Per-user cookies uploaded via the bot are stored under COOKIES_DIR
# COOKIES_DIR=./data/cookies

# Telegram API ID/HASH are not needed for Bot API sending, but kept for future integrations.

# ═══════════════ Vercel mode ═══════════════
# عند النشر على Vercel اضبط هذه في إعدادات المشروع (Environment Variables):
#   VERCEL=1                        ← يضبطها Vercel تلقائيًا
#   TELEGRAM_BOT_TOKEN=...          ← توكن البوت
#   TELEGRAM_API_ID / TELEGRAM_API_HASH ← مفاتيح API (للاستخراج فقط)
#   BASE_URL=https://<مشروعك>.vercel.app
#   DATABASE_URL=sqlite:////tmp/yjdownload.db
#   STORAGE_DIR=/tmp/storage
#   COOKIES_DIR=/tmp/cookies
#   STATUS_DIR=/tmp/status
#   SESSIONS_DIR=/tmp/sessions
#   ENABLE_BROWSER_CAPTURE=false   ← لا متصفح على Vercel
#   TELEGRAM_BOT_API_BASE=         ← فارغ (لا خادم محلي — حد الإرسال 50MB)
# ثم بعد أول نشر شغّل مرة واحدة:
#   WEBHOOK_URL=https://<مشروعك>.vercel.app/webhook/telegram uv run python -m app.setup_webhook

# ═══════════════ كوكيز يوتيوب ═══════════════
# قد تساعد كوكيز حساب مخصص في تجاوز فحص تسجيل الدخول، لكنها ليست ضمانًا دائمًا
# لأن يوتيوب قد يحجب عنوان IP لخوادم الاستضافة، وعندها يلزم بروكسي سكني/ISP ثابت.
# الطريقة (مرة واحدة):
#   1) افتح يوتيوب في Chrome وأنت مسجّل دخول بحساب مخصص
#   2) إضافة Get cookies.txt LOCALLY ← Export ← احفظ الملف
#   3) حوّله:  base64 -w0 cookies.txt  ← انسخ الناتج
#   4) ضعه هنا (أو في متغيرات بيئة Render):
# YOUTUBE_COOKIES_B64=ضع_الناتج_هنا
# INSTAGRAM_COOKIES_B64=ضع_ناتج_كوكيز_انستغرام_هنا

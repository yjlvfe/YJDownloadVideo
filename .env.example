APP_NAME=YJDownloadVideo
ENVIRONMENT=development
# ⚠️ إجباري — بدون قيمة عشوائية طويلة يرفض النظام الإقلاع عمدًا (أمان)
# ولّد واحدة: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./data/yjdownload.db
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost:8000
STORAGE_DIR=./storage
# مدة بقاء الملفات على السيرفر بالثواني (86400 = 24 ساعة ثم حذف تلقائي)
FILE_TTL_SECONDS=86400
MAX_FILE_SIZE_BYTES=21474836480
# مدة غير محدودة (0 = لا حد)
MAX_DURATION_SECONDS=0
RATE_LIMIT_PER_MINUTE=10
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# خادم Bot API محلي (يرفع حد الإرسال إلى 2GB): http://tba:8081 في Docker
TELEGRAM_BOT_API_BASE=http://tba:8081
TELEGRAM_SEND_LIMIT_BYTES=2097152000
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== NordVPN (داخل Docker) — توكن الخدمة من my.nordaccount.com =====
# NORDVPN_TOKEN=

# حد المهام النشطة
MAX_ACTIVE_JOBS_PER_IP=999
MAX_ACTIVE_JOBS_PER_TELEGRAM_USER=999

CLEANUP_INTERVAL_SECONDS=300
CORS_ORIGINS=http://localhost:8000
SECURE_COOKIES=false

# yt-dlp/FFmpeg binaries
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

COMPOSE_PROJECT_NAME=yjdownloadvideo

# Never commit your real .env file.
# Only use this service for content you are authorized to download.
# DRM bypass and site protection circumvention are intentionally unsupported.
